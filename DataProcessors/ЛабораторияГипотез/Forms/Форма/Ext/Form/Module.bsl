	Исключение
		РезультатУспеха = "Ошибка приведения: " + ОписаниеОшибки();
	КонецПопытки;
	
	ШаблонОтвета = "Тестирование строгости типов в запросах:
	|1. Без приведения типов (Строка = Число):
	|   -> %1
	|2. С правильным приведением типов через параметры BSL:
	|   -> %2";
	
	Возврат СтрШаблон(ШаблонОтвета, РезультатОшибки, РезультатУспеха);
	
