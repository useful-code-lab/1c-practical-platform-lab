	Исключение
		// Сюда второе окно прилетит по честному таймауту СУБД!
		Статус = ?(ТранзакцияАктивна(), "Активна в 1С (но мертва в СУБД)", "Отменена");
		Результат = "Честный таймаут СУБД: " + ОписаниеОшибки() + " Статус: " + Статус;
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию(); // Сбрасываем флаг в платформе 1С
