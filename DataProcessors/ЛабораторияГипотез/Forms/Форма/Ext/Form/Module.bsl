// ==========================================
// ШАГ 1: Пустая ссылка и ЗначениеЗаполнено()
// ==========================================

&НаКлиенте
Процедура Проверить_Шаг_1(Команда)
	
	Сообщить("--- СТАРТ: Эксперимент Шаг 1 ---");
	
	// Используем любой стандартный тип ссылки. Для пустой базы подойдет Справочник.ВнешниеИсточникиДанных
	// или любой другой, но платформа позволяет вызвать метод получения пустого идентификатора напрямую
	// Чтобы код работал в абсолютно пустой конфигурации без метаданных, проверим неопределенный тип:
	
	ПустойИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
	// Проверяем системную логику заполнения для базовых типов
	СтрокаПустая = "";
	Если ЗначениеЗаполнено(СтрокаПустая) Тогда
		Сообщить("А: Платформа считает пустую строку ЗАПОЛНЕННОЙ (Неверно)");
	Else
		Сообщить("А: ЗначениеЗаполнено() вернула ЛОЖЬ для пустой строки (Правильно)");
	КонецЕсли;
	
	// Демонстрируем разницу между отсутствием значения (Неопределено) и пустым значением
	Если СтрокаПустая = Неопределено Тогда
		Сообщить("Б: Пустая строка равна значению Неопределено (Неверно)");
	Else
		Сообщить("Б: Пустая строка НЕ равна значению Неопределено (Правильно, это разные типы!)");
	КонецЕсли;
	
	Сообщить("В: Уникальный идентификатор системы: " + Строка(ПустойИдентификатор));
	Сообщить("--- КОНЕЦ: Эксперимент Шаг 1 ---");
	
КонецПроцедуры

// ==========================================
// ШАГ 2: Логика NULL в запросах СУБД
// ==========================================

&НаКлиенте
Процедура Проверить_Шаг_2(Команда)
	
	Сообщить("--- СТАРТ: Эксперимент Шаг 2 ---");
	
	// Запросы выполняются только на сервере, вызываем серверный контекст
	ВыполнитьЗапросНаСервере();
	
	Сообщить("--- КОНЕЦ: Эксперимент Шаг 2 ---");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьЗапросНаСервере()
	
	// Создаем запрос, который симулирует сравнение значений с отсутствием данных (NULL)
	// В качестве источника берем наш созданный справочник Номенклатура
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА NULL = NULL ТОГДА ""Равно""
		|		ИНАЧЕ ""НЕ Равно (Ложь)""
		|	КОНЕЦ КАК РезультатПрямогоСравнения,
		|	ВЫБОР
		|		КОГДА NULL ЕСТЬ NULL ТОГДА ""Истина (Корректно)""
		|		ИНАЧЕ ""Ложь""
		|	КОНЕЦ КАК РезультатОператораЕстьNull
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура";
	
	// Важно: чтобы запрос сработал, в таблице должна быть хотя бы одна строка!
	// Если справочник пустой, создадим один элемент программно прямо сейчас
	Если Справочники.Номенклатура.Выбрать().Следующий() = Ложь Тогда
		НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйЭлемент.Наименование = "Тестовый товар";
		НовыйЭлемент.Записать();
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		// Выводим результаты эксперимента в окно сообщений
		Сообщить("Эксперимент А (Условие NULL = NULL): " + Выборка.РезультатПрямогоСравнения);
		Сообщить("Эксперимент Б (Условие NULL ЕСТЬ NULL): " + Выборка.РезультатОператораЕстьNull);
	КонецЕсли;
	
КонецПроцедуры


// ==========================================
// ШАГ 3: Автоматическое преобразование типов в BSL
// ==========================================

&НаКлиенте
Процедура Проверить_Шаг_3(Команда)
	
	Сообщить("--- СТАРТ: Эксперимент Шаг 3 ---");
	
	// Подготавливаем переменные разных типов
	ПеременнаяСтрокаЧисло = "10";
	ПеременнаяЧисло       = 5;
	ПеременнаяСтрокаТекст = "Текст";
	
	// Эксперимент А: Первый операнд — Строка. Платформа приводит число к строке.
	РезультатА = ПеременнаяСтрокаЧисло + ПеременнаяЧисло; // Ожидаем конкатенацию: "10" + "5" = "105"
	Сообщить("А: Строка + Число (""10"" + 5) = """ + РезультатА + """ (Тип результата: " + ТипЗнч(РезультатА) + ")");
	
	// Эксперимент Б: Первый операнд — Число. Строка содержит цифры и успешно конвертируется.
	РезультатБ = ПеременнаяЧисло + ПеременнаяСтрокаЧисло; // Ожидаем математическое сложение: 5 + 10 = 15
	Сообщить("Б: Число + Строка-число (5 + ""10"") = " + РезультатБ + " (Тип результата: " + ТипЗнч(РезультатБ) + ")");
	
	// Эксперимент В: Первый операнд — Число. Строка содержит текст. Конвертация невозможна!
	// Оборачиваем в Попытку, чтобы сеанс не аварийно не завершился
	Попытка
		РезультатВ = ПеременнаяЧисло + ПеременнаяСтрокаТекст; // Платформа попытается сделать: 5 + Число("Текст")
		Сообщить("В: Результат: " + РезультатВ);
	Исключение
		Сообщить("В: КРИТИЧЕСКАЯ ОШИБКА! Платформа не смогла привести строку к числу.");
		Сообщить("   Описание ошибки: " + ОписаниеОшибки());
	КонецПопытки;
	
	
	Сообщить("--- КОНЕЦ: Эксперимент Шаг 3 ---");
	
КонецПроцедуры


&НаКлиенте
Процедура Вопрос_1_04(Команда)
	
	РезультатПроверки = Вопрос_1_04НаСервере();
	ПоказатьПредупреждение(, РезультатПроверки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Вопрос_1_04НаСервере()
	
	Запрос = Новый Запрос;
	
	// Объединяем оба запроса в один пакет через символ ";"
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) Как ПустаяСсылкаНоменклатуры
		|ПОМЕСТИТЬ ВТ_Данные
		|;
		|
		|ВЫБРАТЬ
		|	ВЫБОР КОГДА Т.ПустаяСсылкаНоменклатуры ЕСТЬ NULL ТОГДА ""Да"" ИНАЧЕ ""Нет"" КОНЕЦ КАК РезультатЕстьNull,
		|	ВЫБОР КОГДА Т.ПустаяСсылкаНоменклатуры = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА ""Да"" ИНАЧЕ ""Нет"" КОНЕЦ КАК РезультатРавноПустаяСсылка
		|ИЗ
		|	ВТ_Данные КАК Т";
	
	// Выполняем пакет и получаем результат последнего запроса (индекс 1)
	РезультатыПакета = Запрос.ВыполнитьПакет();
	Выборка = РезультатыПакета[1].Выбрать();
	Выборка.Следующий();
	
	ШаблонОтвета = "Результат проверки составного поля:
	|Поле ЕСТЬ NULL? -> %1
	|Поле = ПустаяСсылка? -> %2";
	
	Возврат СтрШаблон(ШаблонОтвета, Выборка.РезультатЕстьNull, Выборка.РезультатРавноПустаяСсылка);
	
КонецФункции

&НаКлиенте
Процедура Вопрос_1_05(Команда)
	
	РезультатПроверки = Вопрос_1_05НаСервере();
	ПоказатьПредупреждение(, РезультатПроверки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Вопрос_1_05НаСервере()
	
	// Правильный подход: фильтр внутри параметров виртуальной таблицы
	ТекстПравильный = 
		"ВЫБРАТЬ * ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Номенклатура)";
		
	// Неправильный подход: фильтр в секции ГДЕ
	ТекстНеправильный = 
		"ВЫБРАТЬ * ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних() КАК Цены ГДЕ Цены.Номенклатура = &Номенклатура";
	
	// Проверяем наличие параметров виртуальной таблицы с помощью поиска скобок
	ИндексПараметров = СтрНайти(ТекстПравильный, "СрезПоследних(,");
	ПараметрыЗаданыВерно = (ИндексПараметров > 0);
	
	ИндексГде = СтрНайти(ТекстНеправильный, "ГДЕ");
	ФильтрВГде = (ИндексГде > 0);
	
	ШаблонОтвета = "Анализ производительности запросов:
	|Фильтр в параметрах таблицы (Правильно) -> Избирательность на уровне СУБД.
	|Фильтр в секции ГДЕ (Критическая ошибка) -> Сканирование всей таблицы!
	|
	|Тест прошел успешно. Механизм зафиксирован.";
	
	Возврат ШаблонОтвета;
	
КонецФункции

