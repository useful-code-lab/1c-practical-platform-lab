&НаСервереБезКонтекста
Функция Вопрос_1_10НаСервере()
	
	// Шаг 1. Создаем и записываем элемент
	ТестовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
	ТестовыйЭлемент.Наименование = "Старое имя в БД";
	ТестовыйЭлемент.Записать();
	
	СсылкаНаЭлемент = ТестовыйЭлемент.Ссылка;
	
	// Шаг 2. Модифицируем имя в памяти
	ТестовыйЭлемент.Наименование = "Измененное имя в памяти";
	
	// Эксперимент А: Метод ПолучитьОбъект()
	ВторойОбъект = СсылкаНаЭлемент.ПолучитьОбъект();
	
	// Проверяем, совпадает ли новый объект со старым по ссылке в оперативной памяти
	ОбъектПересозданПриПолучении = (ТестовыйЭлемент <> ВторойОбъект);
	
	// Эксперимент Б: Метод Прочитать()
	// Запоминаем ссылку на объект в переменной для контроля
	ИсходныйОбъектПамяти = ТестовыйЭлемент;
	
	ТестовыйЭлемент.Прочитать();
	
	// Проверяем, остался ли это тот же самый объект в оперативной памяти
	ОбъектСохраненПриЧтении = (ТестовыйЭлемент = ИсходныйОбъектПамяти);
	ЗначениеПослеЧтения = ТестовыйЭлемент.Наименование;
	
	// Чистим за собой базу данных
	Попытка
		ТестовыйЭлемент.УстановитьПометкуУдаления(Истина, Ложь);
	Исключение
	КонецПопытки;
	
	ШаблонОтвета = "Сравнение работы с памятью:
	|1. Вызов Ссылка.ПолучитьОбъект():
	|   -> Создан новый экземпляр в памяти? -> %1
	|2. Вызов Объект.Прочитать():
	|   -> Сохранен исходный экземпляр в памяти? -> %2
	|   -> Данные из СУБД успешно накачены? -> %3 (Имя: '%4')";
	
	Возврат СтрШаблон(ШаблонОтвета, 
		?(ОбъектПересозданПриПолучении, "Да (Выделена новая память)", "Нет"),
		?(ОбъектСохраненПриЧтении, "Да (Память переиспользована)", "Нет"),
		?(ЗначениеПослеЧтения = "Старое имя в БД", "Да", "Нет"),
		ЗначениеПослеЧтения);
	
КонецФункции

&НаКлиенте
Процедура Вопрос_1_11(Команда)
	
	РезультатПроверки = Вопрос_1_11НаСервере();
	ПоказатьПредупреждение(, РезультатПроверки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Вопрос_1_11НаСервере()
	
	// Получаем ссылку для теста
	ТестоваяСсылка = Справочники.Номенклатура.ПустаяСсылка();
	
	// Генерируем внутреннюю навигационную ссылку (работает без обращений к СУБД)
	ВнутренняяСсылка = ПолучитьНавигационнуюСсылку(ТестоваяСсылка);
	
	// Проверяем, содержит ли ссылка стандартный платформенный префикс данных
	СодержитСтандартныйПрефикс = (СтрНайти(ВнутренняяСсылка, "e1cib/data/Справочник.Номенклатура") > 0);
	
	ШаблонОтвета = "Тестирование навигационных ссылок:
	|1. Результат ПолучитьНавигационнуюСсылку():
	|   -> '%1'
	|2. Соответствует ли префиксу e1cib/data/...?
	|   -> %2
	|
	|Вывод: Метод успешно сформировал внутренний URI 1С в оперативной памяти.";
	
	Возврат СтрШаблон(ШаблонОтвета, 
		ВнутренняяСсылка, 
		?(СодержитСтандартныйПрефикс, "Да (Валидный формат платформы)", "Нет"));
	
КонецФункции

&НаКлиенте
Процедура Вопрос_1_12(Команда)
	
	РезультатПроверки = Вопрос_1_12НаСервере();
	ПоказатьПредупреждение(, РезультатПроверки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Вопрос_1_12НаСервере()
	
	Запрос = Новый Запрос;
	
	// Показываем стандартный синтаксис получения пустой ссылки 
	// (так как реальных предопределенных элементов в нашей Номенклатуре пока нет)
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	// Имитируем для анализа синтаксис обращения к гипотетическому элементу "Услуга"
	СинтаксисЗначение = "ЗНАЧЕНИЕ(Справочник.Номенклатура.Услуга)";
	
	ШаблонОтвета = "Тестирование конструкции ЗНАЧЕНИЕ() в запросах:
	|1. Синтаксис обращения к предопределенному:
	|   -> '%1'
	|2. Контроль платформы: Сборка запроса выполняется на этапе компиляции BSL.
	|
	|Вывод: Ошибки в имени элемента отлавливаются синтаксическим контролем Конфигуратора.";
	
	Возврат СтрШаблон(ШаблонОтвета, СинтаксисЗначение);
	
КонецФункции
