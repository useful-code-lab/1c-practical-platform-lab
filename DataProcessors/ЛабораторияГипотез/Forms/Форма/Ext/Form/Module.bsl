&НаСервереБезКонтекста
Функция Вопрос_1_07НаСервере()
	
	РезультатЭксперимента = "";
	
	// Открываем транзакцию
	НачатьТранзакцию();
	
	Попытка
		// Шаг 1. Создаем первый элемент с кодом "ТЕСТ_01" и записываем его в СУБД
		Элемент1 = Справочники.Номенклатура.СоздатьЭлемент();
		Элемент1.Код = "ТЕСТ_01";
		Элемент1.Наименование = "Первый элемент";
		Элемент1.Записать();
		
		// Шаг 2. Создаем второй элемент с точно ТАКИМ ЖЕ кодом. 
		// При вызове Записать() СУБД вернет ошибку нарушения уникальности индекса кода!
		Элемент2 = Справочники.Номенклатура.СоздатьЭлемент();
		Элемент2.Код = "ТЕСТ_01"; 
		Элемент2.Наименование = "Второй элемент (дубль)";
		Элемент2.Записать(); // Здесь код падает в Исключение
		
	Исключение
		РезультатЭксперимента = "Шаг 1. СУБД заблокировала запись дубля кода. Ошибка перехвачена в BSL:
		|" + ОписаниеОшибки();
	КонецПопытки;
	
	// Шаг 3. Пытаемся зафиксировать транзакцию, несмотря на перехваченную ошибку
	Попытка
		ЗафиксироватьТранзакцию();
		РезультатЭксперимента = РезультатЭксперимента + "
		|Шаг 2. Транзакция успешно зафиксирована.";
	Исключение
		РезультатЭксперимента = РезультатЭксперимента + СтрШаблон("
		|
		|Шаг 2. Попытка фиксации взорванной транзакции вызвала ошибку:
		|-> %1", ОписаниеОшибки());
	КонецПопытки;
	
	ШаблонОтвета = "Реальный транзакционный сбой СУБД:
	|%1
	|
	|Вывод: Попытка...Исключение защитила интерфейс, но транзакция внутри СУБД мертва!";
	
	Возврат СтрШаблон(ШаблонОтвета, РезультатЭксперимента);
	
КонецФункции

