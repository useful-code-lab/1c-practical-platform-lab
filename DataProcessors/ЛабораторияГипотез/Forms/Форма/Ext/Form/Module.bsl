Функция Вопрос_2_01НаСервере()
	
	РезультатБлокировки = "";
	
	// Наложение управляемой блокировки возможно СТРОГО внутри транзакции
	НачатьТранзакцию();
	
	Попытка
		// Инициализируем менеджер блокировок данных
		Блокировка = Новый БлокировкаДанных;
		
		// Добавляем элемент блокировки для справочника "Номенклатура"
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
		
		// Устанавливаем режим: Исключительный (запрет на чтение и запись для других транзакций)
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		// Указываем конкретное значение реквизита, которое хотим заблокировать
		ТестоваяСсылка = Справочники.Номенклатура.ПустаяСсылка();
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ТестоваяСсылка);
		
		// Вызываем наложение блокировки на сервере приложений 1С
		Блокировка.Заблокировать();
		
		РезультатБлокировки = "Успешно. Управляемая блокировка наложена на уровне сервера приложений.";
		
		// Фиксируем транзакцию (блокировка автоматически снимается)
		ЗафиксироватьТранзакцию();
	Исключение
		РезультатБлокировки = "Ошибка наложения блокировки: " + ОписаниеОшибки();
		// В случае сбоя обязательно откатываем транзакцию руками, так как явного сбоя СУБД тут нет
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;
	
	ШаблонОтвета = "Тестирование объекта БлокировкаДанных:
	|%1
	|
	|Вывод: Метод Блокировка.Заблокировать() успешно отработал в рамках открытой транзакции BSL.";
	
	Возврат СтрШаблон(ШаблонОтвета, РезультатБлокировки);
	
КонецФункции


