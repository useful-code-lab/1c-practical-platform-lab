	РезультатТеста = "";
	
	НачатьТранзакцию();
	
	Попытка
		// 1. Создаем ПЕРВУЮ блокировку в РАЗДЕЛЯЕМОМ режиме
		Блокировка1 = Новый БлокировкаДанных;
		Элемент1 = Блокировка1.Добавить("Справочник.Номенклатура");
		Элемент1.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент1.УстановитьЗначение("Ссылка", ТестоваяСсылка);
		Блокировка1.Заблокировать();
		
		// 2. Проверяем совместимость: пытаемся наложить ВТОРУЮ блокировку на те же данные в РАЗДЕЛЯЕМОМ режиме
		Блокировка2 = Новый БлокировкаДанных;
		Элемент2 = Блокировка2.Добавить("Справочник.Номенклатура");
		Элемент2.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент2.УстановитьЗначение("Ссылка", ТестоваяСсылка);
		
		// Если они совместимы, код пройдет дальше без ошибок
		Блокировка2.Заблокировать();
		РезультатТеста = "1. Разделяемые блокировки (S + S) успешно наложены одновременно (Совместимы).";
		
	Исключение
		РезультатТеста = "Ошибка совместимости S + S: " + ОписаниеОшибки();
	КонецПопытки;
	
	// Примечание для экзамена: полноценный конфликт блокировок S и X проверяется между ДВУМЯ РАЗНЫМИ СЕАНСАМИ (пользователями).
