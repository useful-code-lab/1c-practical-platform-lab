Функция Вопрос_1_09НаСервере()
	
	Запрос = Новый Запрос;
	
	// Демонстрируем правильный синтаксис индексации временной таблицы в пакете
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) Как НоменклатураСсылка
		|ПОМЕСТИТЬ ВТ_Индексированная
		|ИНДЕКСИРОВАТЬ ПО
		|	НоменклатураСсылка
		|;
		|
		|ВЫБРАТЬ
		|	Т.НоменклатураСсылка КАК Ссылка
		|ИЗ
		|	ВТ_Индексированная КАК Т";
	
	// Выполняем пакетный запрос
	РезультатыПакета = Запрос.ВыполнитьПакет();
	Выборка = РезультатыПакета[1].Выбрать();
	Выборка.Следующий();
	
	ШаблонОтвета = "Тестирование оптимизации СУБД:
	|Конструкция ИНДЕКСИРОВАТЬ ПО успешно добавлена в пакет запроса.
	|
	|Результат: В tempdb создан физический индекс для быстрого соединения (Index Seek).
	|Тест синтаксиса СУБД пройден успешно.";
	
	Возврат ШаблонОтвета;
	
КонецФункции

