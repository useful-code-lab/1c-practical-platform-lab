&НаСервереБезКонтекста
Функция Вопрос_1_08НаСервере()
	
	// Создаем источник данных с текстовым значением, которое нельзя сконвертировать в число
	Источник = Новый Структура;
	Источник.Вставить("ТестовыйРеквизит", "Привет, 1С!");
	
	// Создаем приемник данных, где это же поле изначально является числом
	Приемник = Новый Структура;
	Приемник.Вставить("ТестовыйРеквизит", 42);
	
	ОшибкаВозникла = Ложь;
	ОписаниеСбоя  = "";
	
	Попытка
		// Выполняем копирование свойств с несовпадающими типами данных
		ЗаполнитьЗначенияСвойств(Приемник, Источник);
	Исключение
		ОшибкаВозникла = Истина;
		ОписаниеСбоя  = ОписаниеОшибки();
	КонецПопытки;
	
	ШаблонОтвета = "Тестирование ЗаполнитьЗначенияСвойств():
	|Изначальное значение приемника: 42 (Число)
	|Значение в источнике: 'Привет, 1С!' (Строка)
	|
	|Вызвана ли Runtime-ошибка? -> %1
	|Итоговое значение в приемнике: %2 (Тип: %3)";
	
	ТекстОшибки = ?(ОшибкаВозникла, "Да: " + ОписаниеСбоя, "Нет (Платформа подавила ошибку типа)");
	СтроковоеЗначениеПриемника = Строка(Приемник.ТестовыйРеквизит);
	ИмяТипаПриемника = ТипЗнч(Приемник.ТестовыйРеквизит);
	
	Возврат СтрШаблон(ШаблонОтвета, 
		ТекстОшибки, 
		СтроковоеЗначениеПриемника, 
		ИмяТипаПриемника);
	
КонецФункции

