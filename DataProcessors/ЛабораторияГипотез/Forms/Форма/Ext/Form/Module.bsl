&НаСервереБезКонтекста
Функция Вопрос_1_06НаСервере()
	
	// Получаем пустую ссылку для демонстрации
	СсылкаНаНоменклатуру = Справочники.Номенклатура.ПустаяСсылка();
	
	РезультатПрямойЗаписи = "Успешно";
	РезультатЧерезОбъект  = "Не проверялось";
	
	// Шаг 1. Пытаемся изменить наименование напрямую у Ссылки
	Попытка
		// Этот код вызовет ошибку: Поле объекта недоступно для записи
		СсылкаНаНоменклатуру.Наименование = "Тест";
	Исключение
		// Используем стандартную встроенную функцию платформы
		РезультатПрямойЗаписи = ОписаниеОшибки();
	КонецПопытки;
	
	// Шаг 2. Показываем, как это делается правильно через Объект
	Попытка
		НовыйОбъект = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйОбъект.Наименование = "Временный тест типов";
		РезультатЧерезОбъект = "Успешно (свойства Объекта доступны для изменения)";
	Исключение
		РезультатЧерезОбъект = ОписаниеОшибки();
	КонецПопытки;
	
	ШаблонОтвета = "Эксперимент со Ссылками и Объектами:
	|1. Попытка изменить реквизит Ссылки:
	|   -> Ошибка: %1
	|2. Попытка изменить реквизит Объекта:
	|   -> Результат: %2";
	
	Возврат СтрШаблон(ШаблонОтвета, РезультатПрямойЗаписи, РезультатЧерезОбъект);
	
КонецФункции

